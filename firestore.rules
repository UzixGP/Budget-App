rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /budgets/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validBudget() {
        let d = request.resource.data;
        return d.keys().hasAll(['data', 'revision', 'updatedAt'])
          && d.keys().hasOnly(['data', 'revision', 'updatedAt'])
          && d.revision is int && d.revision > 0
          && d.updatedAt == request.time
          && d.data is map
          && d.data.keys().hasAll(['salary', 'bills', 'expenses', 'pay'])
          && d.data.keys().hasOnly(['salary', 'bills', 'expenses', 'pay', 'commitmentsVersion', 'cash', 'payments'])
          && (!('cash' in d.data) || (d.data.cash is map && d.data.cash.openingBalance is number && d.data.cash.openingDate is string && d.data.cash.periodStart is string && d.data.cash.periodEnd is string))
          && (!('payments' in d.data) || d.data.payments is list)
          && d.data.salary is map && d.data.bills is list
          && d.data.expenses is list && d.data.pay is list;
      }
      allow read: if owner();
      allow create: if owner() && validBudget() && request.resource.data.revision == 1;
      allow update: if owner() && validBudget()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
